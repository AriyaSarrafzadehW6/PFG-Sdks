{
    "name": "persiafava/laravel-sms-sdk",
    "description": "پوسته‌ی Laravel (Service Provider + Facade) روی PersiaFava PHP SMS SDK",
    "license": "MIT",
    "require": {
        "php": ">=7.2",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0",
        "persiafava/sms-sdk": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "PersiaFava\\\\Laravel\\\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PersiaFava\\\\Laravel\\\\PersiaFavaServiceProvider"
            ],
            "aliases": {
                "PersiaFava": "PersiaFava\\\\Laravel\\\\Facades\\\\PersiaFava"
            }
        }
    },
    "minimum-stability": "stable"
}